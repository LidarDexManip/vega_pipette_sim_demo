# Copy this file to config/vega.env and edit it. The run scripts source scripts/env.sh, which reads config/vega.env
# (if present) and fills in the defaults below. Values already set in the environment win over this file.
# Paths may be absolute, start with ~/, or be relative to the repository root.

# Isaac Sim asks you to accept the NVIDIA Omniverse License Agreement. Read it, then set YES here (required).
OMNI_KIT_ACCEPT_EULA=

# Python of the Isaac Sim 6.0.1 + Isaac Lab environment (required), e.g. ~/envs/vega-isaac/bin/python.
VEGA_ISAAC_PY=

# Python of the policy server environment (required), e.g. ~/envs/openpi/.venv/bin/python.
VEGA_POLICY_PY=

# The policy checkpoint directory (with params/ and assets/). Default: checkpoints/vega-wuji-pipette-pi05.
VEGA_CHECKPOINT=

# Physics device for both run scripts: cpu or cuda:0. Default: cpu for run_sim_gui.sh (about twice as fast),
# cuda:0 for run_sim_headless.sh.
VEGA_DEVICE=

# Output root for runs, videos and caches. Default: runs/ under the repository.
VEGA_RUNS=

# Isaac Kit temp dir. Default: $VEGA_RUNS/tmp.
VEGA_TMP=

# GPU index used by the scripts. Default: 0.
VEGA_GPU=
